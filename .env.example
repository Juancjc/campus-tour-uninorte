APP_NAME="Campus Tour UniNorte"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://campustour.exemplo.com
APP_PORT=8080
FORCE_HTTPS=true

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=campus_tour
DB_USERNAME=campus_tour
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids
PM2_APP_NAME=campus-tour-queue

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_API_URL=https://nest.juancjc.com.br/api-nest-central-jc
MAIL_API_KEY=
MAIL_API_TOKEN=
MAIL_API_CONNECT_TIMEOUT=3
MAIL_API_TIMEOUT=10

ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="Campus Tour UniNorte"
